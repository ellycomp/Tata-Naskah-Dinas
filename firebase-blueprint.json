        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profileName": {
          "type": "string",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Pemerintahan", "Perusahaan", "Pendidikan", "Organisasi"],
          "maxLength": 32
        },
        "parentOrg": {
          "type": "string",
          "maxLength": 200
        },
        "orgName": {
          "type": "string",
          "maxLength": 200
        },
        "subUnit": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "contactLine": {
          "type": "string",
          "maxLength": 200
        },
        "websiteLine": {
          "type": "string",
          "maxLength": 200
        },
        "websiteEmailLine": {
          "type": "string",
          "maxLength": 200
        },
        "websiteOnLastLine": {
          "type": "boolean"
        },
        "contactLastLineMode": {
          "type": "string",
          "enum": ["inline", "website-last", "email-last"],
          "maxLength": 20
        },
        "layout": {
          "type": "string",
          "enum": ["left-center", "left-left", "dual-center"],
          "maxLength": 20
        },
        "dividerStyle": {
          "type": "string",
          "enum": ["double-official", "single-bold", "accent-line"],
          "maxLength": 30
        },
        "accentColor": {
          "type": "string",
