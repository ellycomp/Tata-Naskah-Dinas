        },
        "leftLogoSize": {
          "type": "number"
        },
        "showRightLogo": {
          "type": "boolean"
        },
        "rightLogoDataUrl": {
          "type": "string",
          "maxLength": 140000
        },
        "rightLogoSize": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "id",
        "profileName",
        "category",
        "parentOrg",
        "orgName",
        "subUnit",
        "address",
        "contactLine",
        "websiteLine",
        "websiteEmailLine",
        "websiteOnLastLine",
        "contactLastLineMode",
        "layout",
        "dividerStyle",
        "accentColor",
        "builtInLogo",
        "rightBuiltInLogo",
        "customLogoDataUrl",
        "leftLogoSize",
        "showRightLogo",
        "rightLogoDataUrl",
        "rightLogoSize",
        "createdAt",
        "updatedAt"
      ]
    },
    "DecreeData": {
      "title": "DecreeData",
      "description": "Structured decree fields for Surat Keputusan.",
      "type": "object",
      "properties": {
        "about": { "type": "string", "maxLength": 500 },
        "considering": { "type": "array" },
        "legalBasis": { "type": "array" },
        "decisionWord": { "type": "string", "maxLength": 100 },
        "enactLabel": { "type": "string", "maxLength": 100 },
        "enactStatement": { "type": "string", "maxLength": 1000 },
        "clauses": { "type": "array" },
        "establishedIn": { "type": "string", "maxLength": 120 },
        "establishedDate": { "type": "string", "maxLength": 120 }
      },
      "required": [
        "about",
        "considering",
        "legalBasis",
        "decisionWord",
        "enactLabel",
        "enactStatement",
        "clauses",
        "establishedIn",
        "establishedDate"
      ]
    },
    "GiverPartyInfo": {
      "title": "GiverPartyInfo",
      "description": "Assignor or issuing officer metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 400 }
      },
      "required": ["name", "title", "address"]
    },
    "RecipientPartyInfo": {
      "title": "RecipientPartyInfo",
      "description": "Assignee, student, or teacher recipient metadata.",
      "type": "object",
      "properties": {
        "roleType": { "type": "string", "enum": ["guru", "siswa"], "maxLength": 10 },
        "name": { "type": "string", "maxLength": 150 },
        "birthPlaceDate": { "type": "string", "maxLength": 150 },
        "studentNisn": { "type": "string", "maxLength": 40 },
        "teacherIdType": { "type": "string", "enum": ["NIY", "NUPTK"], "maxLength": 10 },
        "teacherIdNumber": { "type": "string", "maxLength": 50 },
        "position": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 400 }
      },
      "required": [
        "roleType",
        "name",
        "birthPlaceDate",
        "studentNisn",
        "teacherIdType",
        "teacherIdNumber",
        "position",
        "address"
      ]
    },
    "ArchivedLetter": {
      "title": "ArchivedLetter",
      "description": "Official letter archived by its authenticated owner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "templateId": { "type": "string", "maxLength": 100 },
        "templateName": { "type": "string", "maxLength": 150 },
        "category": {
          "type": "string",
          "enum": ["Pemerintahan", "Perusahaan", "Pendidikan", "Organisasi"],
          "maxLength": 32
        },
        "formatStyle": {
          "type": "string",
          "enum": ["correspondence", "decree"],
          "maxLength": 24
        },
        "letterKind": {
          "type": "string",
          "enum": ["standard", "sk", "surat-tugas", "surat-keterangan", "surat-kuasa", "surat-pengantar"],
          "maxLength": 24
        },
        "decreeTitle": { "type": "string", "maxLength": 200 },
        "letterhead": { "$ref": "#/entities/LetterheadData" },
        "letterNumber": { "type": "string", "maxLength": 150 },
        "attachment": { "type": "string", "maxLength": 150 },
        "urgency": { "type": "string", "maxLength": 80 },
        "subject": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 120 },
        "dateString": { "type": "string", "maxLength": 120 },
        "recipientLines": { "type": "array" },
        "salutation": { "type": "string", "maxLength": 200 },
        "openingParagraph": { "type": "string", "maxLength": 4000 },
        "detailRows": { "type": "array" },
        "bodyParagraphs": { "type": "array" },
        "closingParagraph": { "type": "string", "maxLength": 4000 },
        "skData": { "$ref": "#/entities/DecreeData" },
        "giverParty": { "$ref": "#/entities/GiverPartyInfo" },
        "recipientParty": { "$ref": "#/entities/RecipientPartyInfo" },
        "recipientParties": { "type": "array" },
        "forwardingItems": { "type": "array" },
        "signerDepartment": { "type": "string", "maxLength": 200 },
        "signerTitle": { "type": "string", "maxLength": 200 },
        "signerName": { "type": "string", "maxLength": 150 },
        "signerIdLabel": { "type": "string", "maxLength": 60 },
        "signerIdValue": { "type": "string", "maxLength": 80 },
        "signatureDataUrl": { "type": "string", "maxLength": 140000 },
        "signatureScale": { "type": "number" },
        "signatureMode": { "type": "string", "enum": ["manual", "qr", "both"], "maxLength": 20 },
        "showManualSignatureBox": { "type": "boolean" },
        "qrSourceMode": { "type": "string", "enum": ["auto-link", "custom-upload"], "maxLength": 24 },
        "qrCustomLink": { "type": "string", "maxLength": 4000 },
        "customQrDataUrl": { "type": "string", "maxLength": 140000 },
        "qrUploadedDecodedUrl": { "type": "string", "maxLength": 4000 },
        "qrSize": { "type": "number" },
        "qrShowCaption": { "type": "boolean" },
        "showStamp": { "type": "boolean" },
        "stampMode": { "type": "string", "enum": ["auto-svg", "custom-png"], "maxLength": 20 },
        "customStampDataUrl": { "type": "string", "maxLength": 140000 },
        "stampScale": { "type": "number" },
        "stampTextTop": { "type": "string", "maxLength": 150 },
        "stampTextCenter": { "type": "string", "maxLength": 150 },
        "stampColor": { "type": "string", "maxLength": 20 },
        "ccList": { "type": "array" },
        "paperSize": { "type": "string", "enum": ["A4", "F4"], "maxLength": 10 },
        "fontFamily": { "type": "string", "enum": ["times", "arial", "georgia"], "maxLength": 20 },
        "fontSizePt": { "type": "number" },
        "marginPreset": { "type": "string", "enum": ["standard", "compact", "wide"], "maxLength": 20 },
        "clientUpdatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "id",
        "templateId",
        "templateName",
        "category",
        "formatStyle",
        "letterKind",
        "decreeTitle",
        "letterhead",
        "letterNumber",
        "attachment",
        "urgency",
        "subject",
        "city",
        "dateString",
        "recipientLines",
        "salutation",
        "openingParagraph",
        "detailRows",
        "bodyParagraphs",
        "closingParagraph",
        "skData",
        "giverParty",
        "recipientParty",
        "recipientParties",
        "forwardingItems",
        "signerDepartment",
        "signerTitle",
        "signerName",
        "signerIdLabel",
        "signerIdValue",
        "signatureDataUrl",
        "signatureScale",
        "signatureMode",
        "showManualSignatureBox",
        "qrSourceMode",
        "qrCustomLink",
        "customQrDataUrl",
        "qrUploadedDecodedUrl",
        "qrSize",
        "qrShowCaption",
        "showStamp",
        "stampMode",
        "customStampDataUrl",
        "stampScale",
        "stampTextTop",
        "stampTextCenter",
        "stampColor",
        "ccList",
        "paperSize",
        "fontFamily",
        "fontSizePt",
        "marginPreset",
        "clientUpdatedAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile keyed by Firebase Auth UID."
    },
    "/users/{userId}/letterheads/{profileId}": {
      "schema": { "$ref": "#/entities/LetterheadProfile" },
      "description": "User-owned saved letterhead profiles."
    },
    "/users/{userId}/letters/{letterId}": {
      "schema": { "$ref": "#/entities/ArchivedLetter" },
      "description": "User-owned archived official letters."
    }
  }
}
