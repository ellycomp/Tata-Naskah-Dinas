{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account metadata stored privately per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address (PII).",
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL or empty string.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial registration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile sync."
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "createdAt", "updatedAt"]
    },
    "LetterheadData": {
      "title": "LetterheadData",
      "description": "Embedded or standalone letterhead configuration object.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profileName": {
          "type": "string",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Pemerintahan", "Perusahaan", "Pendidikan", "Organisasi"],
          "maxLength": 32
        },
        "parentOrg": {
          "type": "string",
          "maxLength": 200
        },
        "orgName": {
          "type": "string",
          "maxLength": 200
        },
        "subUnit": {
          "type": "string",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "contactLine": {
          "type": "string",
          "maxLength": 200
        },
        "websiteLine": {
          "type": "string",
          "maxLength": 200
        },
        "websiteEmailLine": {
          "type": "string",
          "maxLength": 200
        },
        "websiteOnLastLine": {
          "type": "boolean"
        },
        "contactLastLineMode": {
          "type": "string",
          "enum": ["inline", "website-last", "email-last"],
          "maxLength": 20
        },
        "layout": {
          "type": "string",
          "enum": ["left-center", "left-left", "dual-center"],
          "maxLength": 20
        },
        "dividerStyle": {
          "type": "string",
          "enum": ["double-official", "single-bold", "accent-line"],
          "maxLength": 30
        },
        "accentColor": {
          "type": "string",
          "maxLength": 20
        },
        "builtInLogo": {
          "type": "string",
          "enum": ["shield", "corporate", "academic", "organization", "none"],
          "maxLength": 20
        },
        "rightBuiltInLogo": {
          "type": "string",
          "enum": ["shield", "corporate", "academic", "organization", "none"],
          "maxLength": 20
        },
        "customLogoDataUrl": {
          "type": "string",
          "maxLength": 140000
        },
        "leftLogoSize": {
          "type": "number"
        },
        "showRightLogo": {
          "type": "boolean"
        },
        "rightLogoDataUrl": {
          "type": "string",
          "maxLength": 140000
        },
        "rightLogoSize": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "profileName",
        "category",
        "parentOrg",
        "orgName",
        "subUnit",
        "address",
        "contactLine",
        "websiteLine",
        "websiteEmailLine",
        "websiteOnLastLine",
        "contactLastLineMode",
        "layout",
        "dividerStyle",
        "accentColor",
        "builtInLogo",
        "rightBuiltInLogo",
        "customLogoDataUrl",
        "leftLogoSize",
        "showRightLogo",
        "rightLogoDataUrl",
        "rightLogoSize"
      ]
    },
